#!/usr/bin/env bash

function log {
  echo "$@" 1>&2
}

function deletion-candidates {
  local _path="$1"
  active_kernels="$(eselect kernel list | awk '{print $2}' | tail -n+2 | sed -r 's/linux-//' | paste -sd'|')"
  log "ACTIVE: ${active_kernels}"
  sudo ls "$1" \
    | grep -vP "(linux|$(uname -r)|${active_kernels})" \
    | grep -E '\.(img|efi)$' \
    | grep -v 'amd-uc.img'
}

function cleanup-kernels {
  local _path="$1"
  local deletion_list="$(deletion-candidates "$_path")"
  if [[ -z "$deletion_list" ]]; then
    log "No old kernels in ${_path} to cleanup"
  else
    log -e "Cleanup old kernels from ${_path}:\n${deletion_list}"
    echo ''
    for p in $deletion_list; do
      echo -e "\nsudo rm -r \"${_path}/$p\""
      read -n1 -p "Confirm? Y/n" confirm
      if [[ "$confirm" == 'n' ]]; then
        log "Skipping!"
        break
      fi
      sudo rm -r "${_path}/$p"
    done
  fi
}

# Only clean kernels that are no longer installed
# Explicitly exclude currently running system just in case
log "Running kernel: $(uname -r)"
#old_bootloader_path="/boot/efi/$(</etc/machine-id)"
#cleanup-kernels "$old_bootloader_path"
cleanup-kernels /usr/src
cleanup-kernels /boot/efi/EFI/Gentoo

set -eo pipefail

# Newest kernel first so Enter picks it by default; fzf exits non-zero on Esc/no match
running="linux-$(uname -r)"
kernel_select="$(
  eselect kernel list \
    | awk '/^ *\[[0-9]+\]/ { print $2 "\t" ($3 == "*" ? "(selected)" : "") }' \
    | sort -V -r -k1,1 \
    | awk -F'\t' -v run="$running" '{ print $1 "\t" $2 ($1 == run ? " (running)" : "") }' \
    | fzf --height=~40% --layout=reverse --border --no-sort --cycle \
          --delimiter='\t' --accept-nth=1 \
          --prompt='kernel> ' \
          --header="Select kernel to build (running: $(uname -r)) - Enter: select, Esc: abort" \
          --select-1 --exit-0
)" || true
if [[ -z "$kernel_select" ]]; then
  log "No kernel selected!"
  exit 2
fi
sudo eselect kernel set "$kernel_select"

log "Forcing kernel config options..."
(
  cd /usr/src/linux

  declare -A entries=(
    # Gentoo-specific options when using Gentoo kernels
    ["CONFIG_GENTOO_LINUX"]="y"
    ["CONFIG_GENTOO_LINUX_UDEV"]="y"
    ["CONFIG_GENTOO_LINUX_PORTAGE"]="y"
    ["CONFIG_GENTOO_LINUX_INIT_SYSTEMD"]="y"
    ["CONFIG_GENTOO_LINUX_INIT_SCRIPT"]="n"
    ["CONFIG_GENTOO_KERNEL_SELF_PROTECTION"]="y"
    ["CONFIG_GENTOO_PRINT_FIRMWARE_INFO"]="n"
    # 2026-01-12: For some reason, cachyos-sources package is defaulting all debug opts on
    #             resulting in an excessively large and slower kernel (>600MB!)
    ["CONFIG_DEBUG_KERNEL"]="n"
    ["CONFIG_DEBUG_INFO"]="n"
    ["CONFIG_DEBUG_INFO_DWARF5"]="n"
    ["CONFIG_DEBUG_INFO_BTF"]="n"
    ["CONFIG_DEBUG_INFO_BTF_MODULES"]="n"
  )

  # 2026-11-02: Disable unused drivers
  for sym in DRM_AMDGPU DRM_RADEON DRM_I915 DRM_XE DRM_NOUVEAU \
           SND_SOC IIO INFINIBAND SCSI_LOWLEVEL \
           INPUT_TOUCHSCREEN STAGING PCMCIA FIREWIRE NFC CAN ATM FUSION \
           GFS2_FS OCFS2_FS CEPH_FS AFS_FS; do
           # MEDIA_SUPPORT: webcam?
    entries["CONFIG_${sym}"]="n"
  done
  # Disable non-Intel network drivers (unused)
  while read -r sym; do
    entries["$sym"]="n"
  done < <(grep -oP '^CONFIG_(NET|WLAN)_VENDOR_(?!INTEL=)[A-Z0-9_]+(?==y)' .config)

  target="$(mktemp)"
  trap 'sudo rm -f "$target"' EXIT
  cp .config "$target"

  for opt in "${!entries[@]}"; do
    sed -i "/^${opt}=/d; /^# ${opt} is not set\$/d" "$target"
    printf '%s=%s\n' "$opt" "${entries[$opt]}" >> "$target"
  done

  sudo make KCONFIG_CONFIG="$target" olddefconfig

  # Only replace .config if something changed (faster re-run if just updating opts)
  if cmp -s "$target" .config; then
    log "Kernel config already has forced options, leaving .config untouched"
  else
    sudo cp "$target" .config
  fi
)

log "Upgrading kernel and modules"
sudo bash -c 'cd /usr/src/linux && make -j12 && emerge -v @module-rebuild && make modules_install && make install'
